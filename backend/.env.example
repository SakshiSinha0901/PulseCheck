# Copy this file to ".env" and fill in real values. Never commit the real ".env" file.

# PostgreSQL connection string (you'll get this from Neon/Render once the database is created)
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Any random long string - used to sign login tokens. You can generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="replace-this-with-a-long-random-string"

# Port the backend runs on locally
PORT=5000

# Used to send "your site is down" email alerts, via a Gmail account.
# IMPORTANT: this is NOT your normal Gmail password. Gmail blocks that for security.
# You need to generate a 16-character "App Password" instead:
#   1. Turn on 2-Step Verification on your Google account (required first).
#   2. Go to https://myaccount.google.com/apppasswords
#   3. Generate a new app password (name it anything, e.g. "PulseCheck").
#   4. Paste that 16-character code below as EMAIL_PASS (no spaces).
EMAIL_USER="youraddress@gmail.com"
EMAIL_PASS="your-16-character-app-password"
