# Copy this file to ".env" and fill in real values. Never commit the real ".env" file.

# PostgreSQL connection string (you'll get this from Neon/Render once the database is created)
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Any random long string - used to sign login tokens. You can generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="replace-this-with-a-long-random-string"

# Port the backend runs on locally
PORT=5000
